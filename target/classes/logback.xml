<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{YYYY-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.oblivion.neoproxy" level="DEBUG" additivity="false"> <!-- Changed to DEBUG -->
        <appender-ref ref="STDOUT" />
    </logger>

    <logger name="io.netty" level="WARN" additivity="false">
        <appender-ref ref="STDOUT" />
    </logger>

    <logger name="org.springframework" level="INFO" additivity="false">
        <appender-ref ref="STDOUT" />
    </logger>

    <!-- Spring Boot's embedded Tomcat/Netty for web server parts if any (e.g. Actuator) -->
    <logger name="org.apache.coyote.http11" level="WARN" additivity="false">
        <appender-ref ref="STDOUT" />
    </logger>
    <logger name="org.apache.tomcat" level="WARN" additivity="false">
        <appender-ref ref="STDOUT" />
    </logger>
     <logger name="reactor.netty" level="WARN" additivity="false">
        <appender-ref ref="STDOUT" />
    </logger>


    <root level="INFO"> <!-- Changed default root level to INFO -->
        <appender-ref ref="STDOUT" />
    </root>

</configuration>
